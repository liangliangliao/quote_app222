<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/behavior_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/behavior_observation_widget_bg"
    android:padding="10dp">

    <TextView
        android:id="@+id/behavior_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="行为观察"
        android:textColor="#0F172A"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/behavior_widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="点选层面 → 直接填写表单"
        android:textColor="#64748B"
        android:textSize="11sp"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_behavior"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:background="@drawable/behavior_observation_widget_button_primary"
            android:text="行为"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_time"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:background="@drawable/behavior_observation_widget_button"
            android:text="时间"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_emotion"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:background="@drawable/behavior_observation_widget_button"
            android:text="情绪"
            android:textColor="#1E293B"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_btn_cognition"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:background="@drawable/behavior_observation_widget_button"
            android:text="认知"
            android:textColor="#1E293B"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_btn_result"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:gravity="center"
            android:background="@drawable/behavior_observation_widget_button"
            android:text="结果"
            android:textColor="#1E293B"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_environment"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:background="@drawable/behavior_observation_widget_button"
            android:text="环境"
            android:textColor="#1E293B"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_btn_body"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:background="@drawable/behavior_observation_widget_button"
            android:text="身体"
            android:textColor="#1E293B"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
