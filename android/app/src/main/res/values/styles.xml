<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is on -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Show a splash screen on Android 12+; fallback to launch_background elsewhere -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme is restored in MainActivity by Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>


    <style name="BehaviorObservationWidgetFormTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:colorAccent">#4F5FA3</item>
    </style>

    <style name="BehaviorObservationTransparentTheme" parent="android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">#4F5FA3</item>
    </style>


    <style name="BehaviorObservationPresetAlarmTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@android:color/white</item>
        <!-- Do not declare show/turn-screen-on/keep-screen-on as style items here.
             They are not valid style attrs on the CI compileSdk resource table and caused
             AAPT resource linking failures. BehaviorPresetAlarmFormActivity sets the
             equivalent flags programmatically via setShowWhenLocked/setTurnScreenOn and
             FLAG_KEEP_SCREEN_ON. -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">#4F5FA3</item>
    </style>

</resources>
