    <!-- Receiver to handle device unlock events and trigger vision reminders.
         Android 8+ limits certain implicit broadcasts (USER_PRESENT) when the app is in the background.
         To improve reliability we also listen for USER_UNLOCKED. -->
    <!-- UnlockReceiver is kept for in-process delegation only.
         System will not deliver implicit USER_PRESENT/SCREEN_ON broadcasts
         directly to this receiver; instead ScreenGatekeeperService registers
         its own dynamic receiver and calls into UnlockReceiver as needed. -->
<receiver
    android:name=".UnlockReceiver"
    android:enabled="true"
    android:exported="true">
    <!-- 只监听解锁相关广播（USER_PRESENT / USER_UNLOCKED），避免与其他广播/监听重复触发 -->
    <intent-filter>
        <action android:name="android.intent.action.USER_PRESENT" />
        <action android:name="android.intent.action.USER_UNLOCKED" />
    </intent-filter>
</receiver>

    <!-- 解锁延迟兜底（<=5分钟）：由 SCREEN_ON 调度 AlarmManager 触发，显式 Intent 回调到此接收器。 -->
    <receiver
        android:name=".UnlockWatchdogReceiver"
        android:enabled="true"
        android:exported="false" />

    <!-- 无常驻通知的命中率增强：低频脉冲探测锁屏/解锁状态（显式 PendingIntent 回调）。 -->
    <receiver
        android:name=".UnlockPulseReceiver"
        android:enabled="true"
        android:exported="false" />
    <receiver android:name="androidx.work.impl.background.systemalarm.RescheduleReceiver" android:enabled="false" android:exported="false" tools:replace="android:enabled">
