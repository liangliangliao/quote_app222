        </intent>

        <!-- Android 11+ package visibility: allow speech_to_text to discover
             installed speech recognition services. Without this, some devices
             report recognizerNotAvailable even when a recognizer exists. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>
