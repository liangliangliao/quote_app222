    <!-- Allow url_launcher to resolve external browser handlers for https links. -->
    <queries>
        <!-- Allow detecting the Health Connect provider package on Android 11+. -->
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>

        <!-- Android 11+ package visibility: allow resolving live wallpaper picker/preview entries. -->
        <intent>
