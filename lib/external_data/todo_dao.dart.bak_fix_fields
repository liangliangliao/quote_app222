  Future<List<TodoTaskRecord>> listTasks(String listId, {String filter = 'all', int limit = 50, int offset = 0}) async {
    final db = await _db;
    var where = 't.list_id = ? AND t.local_deleted = 0';
    final args = <Object?>[listId];
    if (filter == 'open') where += " AND t.status != 'completed'";
    if (filter == 'completed') where += " AND t.status = 'completed'";
    final rows = await db.rawQuery('''
      SELECT t.*,
             (SELECT COUNT(*) FROM ms_todo_task_children c WHERE c.task_id = t.task_id AND c.child_type = 'checklistItem') AS checklist_count,
             (SELECT COUNT(*) FROM ms_todo_task_children c WHERE c.task_id = t.task_id AND c.child_type = 'attachment') AS attachment_count,
             (SELECT COUNT(*) FROM ms_todo_task_children c WHERE c.task_id = t.task_id AND c.child_type = 'linkedResource') AS linked_resource_count
      FROM ms_todo_tasks t
      WHERE $where
      ORDER BY CASE WHEN t.status = 'completed' THEN 1 ELSE 0 END, t.due_date_time ASC, t.last_modified_date_time DESC
      LIMIT ? OFFSET ?
    ''', [...args, limit, offset]);
    return rows.map(TodoTaskRecord.fromMap).toList();
  }

